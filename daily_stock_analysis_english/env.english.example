# Daily Stock Analysis English configuration
# Copy this file to .env before running the upstream-style app.

STOCK_LIST=600519,hk00700,AAPL,TSLA

# English report output
REPORT_LANGUAGE=en
REPORT_TYPE=full

# Web/API workspace
WEBUI_ENABLED=true
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8000
WEBUI_AUTO_BUILD=true
API_PORT=8000
CORS_ALLOW_ALL=false

# Storage
LOG_DIR=logs
DATABASE_PATH=data/stock_analysis.db
REPORTS_DIR=reports

# Market data sources
TUSHARE_TOKEN=
TICKFLOW_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# Longbridge optional US/HK fallback
LONGBRIDGE_OAUTH_CLIENT_ID=
LONGBRIDGE_OAUTH_TOKEN_CACHE_B64=
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_REGION=hk
LONGBRIDGE_ENABLE_OVERNIGHT=false

# Data-source priority
REALTIME_SOURCE_PRIORITY=tencent,akshare_sina,efinance,akshare_em
SNAPSHOT_SOURCE_PRIORITY=em_datacenter,tushare,efinance,akshare_em
STOCK_INDEX_REMOTE_UPDATE_ENABLED=true
ENABLE_REALTIME_QUOTE=true
ENABLE_REALTIME_TECHNICAL_INDICATORS=true
ENABLE_FUNDAMENTAL_PIPELINE=true
ENABLE_CHIP_DISTRIBUTION=false
ENABLE_EASTMONEY_PATCH=false
EFINANCE_CALL_TIMEOUT=30

# AI model providers. Configure at least one for AI analysis.
ANSPIRE_API_KEYS=
AIHUBMIX_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
DEEPSEEK_API_KEY=

# Multi-channel LLM routing, optional
LLM_CHANNELS=
LITELLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SEC=60

# News/search providers. Configure at least one for better catalyst/risk analysis.
SERPAPI_API_KEYS=
TAVILY_API_KEYS=
BOCHA_API_KEYS=
BRAVE_API_KEYS=
MINIMAX_API_KEYS=
SEARXNG_BASE_URLS=
NEWS_MAX_AGE_DAYS=3

# Agent strategy chat
AGENT_ENABLED=false
AGENT_ARCH=single
AGENT_SKILLS=bull_trend,ma_golden_cross,volume_breakout,hot_theme,event_driven,growth_quality
AGENT_MAX_STEPS=10
AGENT_TIMEOUT_SEC=600

# Notifications, optional
WECHAT_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVERS=

# Runtime behavior
TRADING_DAY_CHECK_ENABLED=true
USE_PROXY=false
PROXY_HOST=127.0.0.1
PROXY_PORT=10809
LOG_LEVEL=INFO
